# --- Telegram (get API ID/hash from https://my.telegram.org, bot token from @BotFather) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Your personal chat id -- the bot will only ever talk to this one person.
# Send /start to your bot after first run and check the logs, or message @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# Comma-separated list of channels/groups you want watched. Prefer the
# @username if the chat has a public one -- most reliable option, e.g.
#   TELEGRAM_JOB_CHANNELS=remote_data_jobs,gulf_it_jobs,@company_careers
# Private groups with no public username don't have a resolvable @handle;
# for those, use the exact chat title as it appears in your Telegram app
# (the engine will match it against your dialog list on startup), e.g.
#   TELEGRAM_JOB_CHANNELS=Hire Abroad - IT community,Naveed's Telegram Family
# Title matching is a fallback and less robust than a @username (breaks if
# you rename the chat) -- check the startup logs for "Resolved channel"
# lines to confirm each one matched correctly.
TELEGRAM_JOB_CHANNELS=

# --- LLM (Groq: https://console.groq.com/keys -- free tier, open-weight models) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email sending (Gmail example: use a 16-char App Password, not your real password) ---
# Create one at https://myaccount.google.com/apppasswords (needs 2FA enabled first)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Your Name

# Path to your resume PDF, attached to every application email
RESUME_PATH=./data/resume.pdf

# Minimum seconds between two outgoing application emails
SEND_COOLDOWN_SECONDS=90

# 24h local time (HH:MM) the daily summary is sent to you on Telegram
DAILY_REPORT_TIME=21:00

# How often (seconds) each watched channel is checked for new messages.
# It only looks at messages newer than the last check per channel, not a
# fixed lookback window each time. Trigger an immediate check any time
# with /refresh in the bot instead of waiting for the interval.
POLL_INTERVAL_SECONDS=1800

# The very first time a channel is checked (ever, or after clearing data/),
# how many days back to seed the starting point (0 = only messages from
# that first check forward). Doesn't affect later checks, which always
# pick up from where the last one left off. You can also pull a deeper
# slice of history any time via /backfill [days] in the bot.
BACKFILL_DAYS=0
